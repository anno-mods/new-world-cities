 <!-- Shared Production OW Fedoras -->
<ModOps>
  <!-- # Unlocks -->
  <Group>
    <ModOp Type="add" Path="//Assets[Asset/Values/Standard/GUID='130248']">
      <Asset>
        <Template>AssetPool</Template>
        <Values>
          <Standard>
            <GUID>1500040004</GUID>
            <Name>NW Fedora Asset Pool</Name>
          </Standard>
          <AssetPool>
            <AssetList>
              <Item>
                <!-- Fedora -->
                <Asset>1555000124</Asset>
              </Item>
              <Item>
                <Asset>1555000128</Asset>
              </Item>
              <Item>
                <Asset>1555000127</Asset>
              </Item>
              <Item>
                <Asset>1500040001</Asset>
              </Item>
            </AssetList>
          </AssetPool>
        </Values>
      </Asset>
    </ModOp>
  </Group>

  <!-- # Menu -->
  <Group>
    <!-- Consumables -->
    <ModOp Type="addNextSibling" GUID="500950"
      Path="/Values/ConstructionCategory/BuildingList/Item[Artista or Patrono &lt;= 1][last()]">
      <Item>
        <Building>1500040001</Building>
        <Patrono>1</Patrono>
      </Item>
    </ModOp>

    <!-- OW Tier + Consumables -->
    <!-- TODO is placing at 1000 Artisan the right spot? -->
    <!-- TODO condition for Merchants -->
    <Group>
      <ModOp Type="add" GUID="25000191"
        Condition="/Values/ConstructionCategory/BuildingList[not(Item/Building='1555000128')]"
        Path="/Values/ConstructionCategory/BuildingList">
        <Item>
          <Building>1555000128</Building>
          <Artisan>1000</Artisan>
        </Item>
      </ModOp>
      <ModOp Type="add" GUID="500945"
        Condition="/Values/ConstructionCategory/BuildingList[not(Item/Building='1555000128')]"
        Path="/Values/ConstructionCategory/BuildingList">
        <Item>
          <Building>1555000128</Building>
          <Artisan>1000</Artisan>
        </Item>
      </ModOp>
    </Group>

    <ModOp Type="addNextSibling" GUID="500002">
      <Asset>
        <Template>ProductionChain</Template>
        <Values>
          <Standard>
            <GUID>1500040001</GUID>
            <Name>Fedoras NW Chain</Name>
            <IconFilename>data/ui/Drakkam/icons/icon_fedora_hat.png</IconFilename>
            <InfoDescription>1500011055</InfoDescription>
          </Standard>
          <Text>
            <TextOverride>1555000128</TextOverride>
          </Text>
          <ProductionChain />
          <Locked />
        </Values>
      </Asset>
    </ModOp>
    <ModOp Type="replace" GUID="1500040001" Path="/Values/ProductionChain"
      Content="@1555000128/ProductionChain">
    </ModOp>
  </Group>

  <!-- TODO Fix: the shared mod is still wrongfully using threads -->
  <ModOp Type="replace" GUID="1555000127" Path="/Values/FactoryBase/FactoryInputs/Item[Product='1500020010']">
    <Item>
      <Product>1010197</Product>
      <Amount>1</Amount>
      <StorageAmount>5</StorageAmount>
    </Item>
  </ModOp>
</ModOps>