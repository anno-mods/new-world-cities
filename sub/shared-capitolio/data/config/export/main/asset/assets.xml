<ModOps>
  <Include File="./capitolio.include.xml"/>
  
  <!-- New World Tourism Compatibility -->
  <Group Condition="#FamTaubeLexy_NewWorldHotels">
    <!-- Add Bus Stop Palace need -->
    <ModOp GUID="1440134301" Type="add" Path="/Values/BusStop/ShowNeeds/">
      <Item>
        <Need>2143505236</Need>
      </Item>
    </ModOp>
    <!-- End Add Bus Stop Palace need -->

    <!-- Add Bus Connections -->
    <ModOp GUID="2143505145" Type="add" Path="/Values">
      <BusActivation>
        <BusNeed>2143505236</BusNeed>
      </BusActivation>
    </ModOp>

    <ModOp GUID='134346' Type="add" Path="/Values/FeedbackBuildingGroup/Buildings">
      <Item>
        <Building>2143505145</Building>
      </Item>
    </ModOp>
    <!-- End Bus Connections -->

    <ModOp GUID="134257" Type="addNextSibling">
      <Asset>
        <BaseAssetGUID>134257</BaseAssetGUID>
        <Values>
          <Standard>
            <GUID>2143505236</GUID>
            <IconFilename>data/ui/2kimages/main/3dicons/palace/icon_palace.png</IconFilename>
            <Name>Palace Need</Name>
          </Standard>
          <Text>
            <TextOverride>249947</TextOverride>
          </Text>
          <Locked />
          <Product>
            <AssociatedRegion>Colony01</AssociatedRegion>
          </Product>
          <ExpeditionAttribute />
        </Values>
      </Asset>
    </ModOp>

    <ModOp Type="addNextSibling" GUID="601379" Path="/Values/PopulationLevel7/PopulationInputs/Item[Product='134257']">
      <Item>
        <Product>2143505236</Product>
        <HappinessValue>3</HappinessValue>
        <IsOptionalHappinessValue>1</IsOptionalHappinessValue>
        <MoneyValue>75</MoneyValue>
        <FullWeightPopulationCount>1100</FullWeightPopulationCount>
        <NoWeightPopulationCount>899</NoWeightPopulationCount>
        <AdditionalGlobalUnlockRequirement>
          <Population>601379</Population>
          <MinPopulationAmount>900</MinPopulationAmount>
        </AdditionalGlobalUnlockRequirement>
        <RequiredBuildings>
          <Item>
            <RequiredBuilding>1440134300</RequiredBuilding>
            <Region>Colony01</Region>
          </Item>
        </RequiredBuildings>
      </Item>
    </ModOp>
  </Group>
</ModOps>
